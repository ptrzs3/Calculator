# Copy this file to "keystore.properties" in the project root and fill in your values.
# keystore.properties is gitignored — do not commit it.
#
# 1) Create a keystore (one-time), e.g.:
#    keytool -genkey -v -keystore keystore/release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias release
#
# 2) Path is relative to the project root (use forward slashes on all OS):
storeFile=keystore/release.jks
storePassword=your_store_password
keyAlias=release
keyPassword=your_key_password
